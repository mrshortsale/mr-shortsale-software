VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Used by Supabase Edge Functions (Dashboard → Project Settings → Edge Functions → Secrets)
# Or: supabase secrets set JWT_SECRET=... INTEGRATION_ENCRYPTION_KEY=...
# For local dev with `supabase functions serve`, add to supabase/.env.local
JWT_SECRET=your-random-32-char-secret-here
INTEGRATION_ENCRYPTION_KEY=your-random-32-char-secret-here-min-32-chars
